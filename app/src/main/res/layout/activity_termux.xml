<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/main_content_with_session_name_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/session_name_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:longClickable="false"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/main_content_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/browser_content_container"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:background="?attr/termuxActivityDrawerBackground"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/browser_page_title_url_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/termuxActivityDrawerBackground"
                            android:clickable="true"
                            android:ellipsize="end"
                            android:focusable="true"
                            android:lineSpacingMultiplier="1.1"
                            android:longClickable="true"
                            android:maxLines="4"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textSize="12sp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                                android:id="@+id/browser_swipe_refresh"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/termuxActivityDrawerBackground">

                                <WebView
                                    android:id="@+id/browser_web_view"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:importantForAutofill="yes"
                                    android:background="?attr/termuxActivityDrawerBackground" />
                            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                            <View
                                android:id="@+id/browser_web_view_cover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/termuxActivityDrawerBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:visibility="gone" />

                            <ProgressBar
                                android:id="@+id/browser_page_load_progress_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:clickable="false"
                                android:focusable="false"
                                android:max="100"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/browser_project_overview_actions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="16dp"
                                android:gravity="end"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                                    android:id="@+id/browser_open_all_tasks_button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="12dp"
                                    android:contentDescription="@string/action_browser_open_all_tasks"
                                    android:text="@string/action_browser_open_all_tasks" />

                                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                                    android:id="@+id/browser_open_first_ten_tasks_button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/action_browser_open_first_ten_tasks"
                                    android:text="@string/action_browser_open_first_ten_tasks" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/browser_terminal_divider"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:background="?attr/termuxActivityDrawerBackground"
                        android:clickable="true"
                        android:contentDescription="@string/action_resize_browser_terminal_split"
                        android:focusable="false"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="4dp"
                            android:background="@drawable/browser_terminal_divider_handle" />
                    </LinearLayout>

                    <com.termux.view.TerminalView
                        android:id="@+id/terminal_view"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusableInTouchMode="true"
                        android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                        android:scrollbars="vertical"
                        tools:ignore="UnusedAttribute" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/right_drawer"
                android:layout_width="260dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:descendantFocusability="beforeDescendants"
                android:orientation="vertical"
                android:background="?attr/termuxActivityDrawerBackground">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/browser_drawer_session_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ListView
                    android:id="@+id/browser_tabs_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp" />

                <CheckBox
                    android:id="@+id/browser_desktop_mode_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/action_browser_desktop_mode" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/browser_new_tab_button"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_browser_new_tab" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/browser_open_in_chrome_button"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/action_browser_open_in_chrome"
                    android:text="@string/action_browser_open_in_chrome" />

                <LinearLayout
                    android:id="@+id/browser_project_url_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <View
            android:id="@+id/session_list_bottom_sheet_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:background="@android:color/transparent"
            android:elevation="5dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/session_list_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:layout_alignParentStart="true"
            android:background="?attr/termuxActivityDrawerBackground"
            android:elevation="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/session_list_bottom_sheet_drag_handle"
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/session_list_bottom_sheet_drag_handle" />

            <TextView
                android:id="@+id/session_list_bottom_sheet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="@string/title_session_list_bottom_sheet"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/session_list_bottom_sheet_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:longClickable="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/session_list_bottom_sheet_settings_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_open_settings"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings"
                    android:tint="?attr/termuxActivityDrawerImageTint" />

                <ImageButton
                    android:id="@+id/session_list_bottom_sheet_new_session_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_new_session"
                    android:padding="12dp"
                    android:src="@drawable/ic_add"
                    android:tint="?attr/termuxActivityDrawerImageTint" />

                <ImageButton
                    android:id="@+id/session_list_bottom_sheet_load_session_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_load_session_definition"
                    android:padding="12dp"
                    android:src="@drawable/ic_load_session"
                    android:tint="?attr/termuxActivityDrawerImageTint" />

                <ImageButton
                    android:id="@+id/session_list_bottom_sheet_google_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_open_google"
                    android:padding="12dp"
                    android:src="@drawable/ic_google"
                    android:tint="?attr/termuxActivityDrawerImageTint" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/terminal_toolbar_bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/schema_terminal_chrome_surface"
            android:elevation="6dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/terminal_toolbar_tmux_mouse_toggle_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_toolbar_tmux_mouse_toggle"
                android:padding="8dp"
                android:src="@drawable/ic_toolbar_mouse"
                android:tint="@color/white" />

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/terminal_toolbar_view_pager"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="37.5dp"
                android:layout_weight="1"
                android:background="@color/schema_terminal_chrome_surface" />

            <ImageButton
                android:id="@+id/terminal_toolbar_browser_toggle_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_toggle_browser"
                android:padding="8dp"
                android:src="@drawable/ic_browser_toggle"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/terminal_toolbar_keyboard_toggle_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_toggle_soft_keyboard_bar"
                android:padding="8dp"
                android:src="@drawable/ic_keyboard_toggle"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/terminal_toolbar_session_sheet_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_open_session_sheet"
                android:padding="8dp"
                android:src="@drawable/ic_session_sheet_toggle"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/terminal_toolbar_right_drawer_toggle_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_toggle_right_drawer_bar"
                android:padding="8dp"
                android:src="@drawable/ic_drawer_toggle"
                android:tint="@color/white" />
        </LinearLayout>

        <View
            android:id="@+id/terminal_toolbar_bottom_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:layout_alignParentStart="true"
            android:background="?attr/termuxActivityBottomSeparatorColor"
            android:elevation="6dp"
            android:importantForAccessibility="no" />

        <ProgressBar
            android:id="@+id/session_definition_loading_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:layout_alignParentStart="true"
            android:clickable="false"
            android:focusable="false"
            android:indeterminate="true"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/session_switch_picker_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:clickable="false"
            android:elevation="12dp"
            android:focusable="false"
            android:visibility="gone">

            <View
                android:id="@+id/session_switch_picker_dim_scrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/session_switch_picker_structure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/session_switch_picker_overlay_background"
                android:clickable="false"
                android:focusable="false"
                android:lineSpacingExtra="2dp"
                android:maxWidth="280dp"
                android:padding="12dp"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </FrameLayout>

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
