<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/main_content_with_session_name_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/main_content_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/browser_content_container"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="2"
                        android:background="?attr/termuxActivityDrawerBackground"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <androidx.coordinatorlayout.widget.CoordinatorLayout
                            android:id="@+id/browser_content_coordinator"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent">

                        <LinearLayout
                            android:id="@+id/browser_content_inner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/browser_page_title_url_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/termuxActivityDrawerBackground"
                            android:clickable="true"
                            android:ellipsize="end"
                            android:focusable="true"
                            android:lineSpacingMultiplier="1.1"
                            android:longClickable="true"
                            android:maxLines="4"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:textSize="12sp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <com.termux.app.browser.BrowserPinchAwareSwipeRefreshLayout
                                android:id="@+id/browser_swipe_refresh"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/termuxActivityDrawerBackground">

                                <FrameLayout
                                    android:id="@+id/browser_web_view_container"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:importantForAutofill="yes"
                                    android:background="?attr/termuxActivityDrawerBackground" />
                            </com.termux.app.browser.BrowserPinchAwareSwipeRefreshLayout>

                            <View
                                android:id="@+id/browser_web_view_cover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/termuxActivityDrawerBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:visibility="gone" />

                            <ProgressBar
                                android:id="@+id/browser_page_load_progress_bar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:clickable="false"
                                android:focusable="false"
                                android:max="100"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/browser_find_bar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:background="?attr/termuxActivityDrawerBackground"
                                android:elevation="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="2dp"
                                android:visibility="gone">

                                <EditText
                                    android:id="@+id/browser_find_query_input"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_browser_find_in_page"
                                    android:imeOptions="actionSearch"
                                    android:importantForAutofill="no"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:singleLine="true"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/browser_find_match_counter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="6dp"
                                    android:minWidth="40dp"
                                    android:gravity="center"
                                    android:textSize="12sp" />

                                <ImageButton
                                    android:id="@+id/browser_find_prev_button"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/action_browser_find_prev"
                                    android:src="@drawable/ic_browser_find_prev"
                                    android:tint="?attr/termuxActivityDrawerImageTint" />

                                <ImageButton
                                    android:id="@+id/browser_find_next_button"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/action_browser_find_next"
                                    android:src="@drawable/ic_browser_find_next"
                                    android:tint="?attr/termuxActivityDrawerImageTint" />

                                <ImageButton
                                    android:id="@+id/browser_find_close_button"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/action_browser_find_close"
                                    android:src="@drawable/ic_browser_find_close"
                                    android:tint="?attr/termuxActivityDrawerImageTint" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/browser_project_overview_actions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|end"
                                android:layout_margin="16dp"
                                android:gravity="end"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/browser_open_all_tasks_button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="12dp"
                                    android:contentDescription="@string/action_browser_open_all_tasks"
                                    app:fabSize="mini"
                                    app:maxImageSize="20dp"
                                    app:srcCompat="@drawable/ic_browser_open_all_tasks"
                                    app:tint="@android:color/white" />

                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/browser_open_first_ten_tasks_button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/action_browser_open_first_ten_tasks"
                                    app:fabSize="mini"
                                    app:maxImageSize="20dp"
                                    app:srcCompat="@drawable/ic_browser_open_first_ten_tasks"
                                    app:tint="@android:color/white" />
                            </LinearLayout>
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/browser_tab_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/termuxActivityDrawerBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <HorizontalScrollView
                                android:id="@+id/browser_tab_strip_scroll"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:scrollbars="none"
                                android:visibility="gone">
                                <LinearLayout
                                    android:id="@+id/browser_tab_strip_container"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal" />
                            </HorizontalScrollView>

                            <LinearLayout
                                android:id="@+id/browser_tab_bar_project_actions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/browser_tab_bar_overview_button"
                                    android:layout_width="40dip"
                                    android:layout_height="40dip"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:contentDescription="@string/action_open_project_overview"
                                    android:focusable="true"
                                    android:padding="9dip"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_browser_toggle"
                                    android:tint="?attr/termuxActivityDrawerImageTint"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/browser_tab_bar_tdpm_console_button"
                                    android:layout_width="40dip"
                                    android:layout_height="40dip"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:contentDescription="@string/action_open_project_tdpm_console"
                                    android:focusable="true"
                                    android:padding="9dip"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_tdpm_console"
                                    android:tint="?attr/termuxActivityDrawerImageTint"
                                    android:visibility="gone" />

                                <ImageView
                                    android:id="@+id/browser_tab_bar_new_issue_button"
                                    android:layout_width="40dip"
                                    android:layout_height="40dip"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:contentDescription="@string/action_open_project_new_issue"
                                    android:focusable="true"
                                    android:padding="9dip"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_add_task"
                                    android:tint="?attr/termuxActivityDrawerImageTint"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>
                        </LinearLayout>
                        </androidx.coordinatorlayout.widget.CoordinatorLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/browser_terminal_divider"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:background="?attr/termuxActivityDrawerBackground"
                        android:clickable="true"
                        android:contentDescription="@string/action_resize_browser_terminal_split"
                        android:focusable="false"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="4dp"
                            android:background="@drawable/browser_terminal_divider_handle" />
                    </LinearLayout>

                    <com.termux.view.TerminalView
                        android:id="@+id/terminal_view"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:defaultFocusHighlightEnabled="false"
                        android:focusableInTouchMode="true"
                        android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                        android:scrollbars="vertical"
                        tools:ignore="UnusedAttribute" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/session_info_bottom_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/session_info_bars_column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/session_project_story_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:ellipsize="end"
                            android:focusable="false"
                            android:longClickable="false"
                            android:maxLines="1"
                            android:paddingHorizontal="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="0dp"
                            android:textColor="#80FFFFFF"
                            android:textSize="9sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/session_name_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:ellipsize="end"
                            android:focusable="false"
                            android:longClickable="false"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:textColor="#80FFFFFF"
                            android:textSize="11sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/session_last_reply_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:ellipsize="end"
                            android:focusable="false"
                            android:longClickable="false"
                            android:maxLines="1"
                            android:paddingHorizontal="6dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="2dp"
                            android:textColor="#80FFFFFF"
                            android:textSize="9sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/owner_call_pending_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:clickable="true"
                        android:contentDescription="@string/owner_call_pending_indicator_content_description"
                        android:focusable="true"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="0dp"
                        android:text="🔴"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/right_drawer"
                android:layout_width="260dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:descendantFocusability="beforeDescendants"
                android:orientation="vertical"
                android:background="?attr/termuxActivityDrawerBackground">

                <ListView
                    android:id="@+id/browser_tabs_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="0dp" />

                <LinearLayout
                    android:id="@+id/browser_action_icon_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <ImageButton
                        android:id="@+id/browser_desktop_mode_toggle"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_browser_desktop_mode_toggle"
                        android:src="@drawable/ic_browser_desktop_mode"
                        android:tint="?attr/termuxActivityDrawerImageTint" />

                    <ImageButton
                        android:id="@+id/browser_new_tab_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_browser_new_tab"
                        android:src="@drawable/ic_add"
                        android:tint="?attr/termuxActivityDrawerImageTint" />

                    <ImageButton
                        android:id="@+id/browser_bookmark_toggle_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_browser_bookmark_current_page"
                        android:src="@drawable/ic_browser_bookmark_star_outline"
                        android:tint="?attr/termuxActivityDrawerImageTint" />

                    <ImageButton
                        android:id="@+id/browser_open_in_chrome_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_browser_open_in_chrome"
                        android:src="@drawable/ic_open_in_new"
                        android:tint="?attr/termuxActivityDrawerImageTint" />

                    <ImageButton
                        android:id="@+id/browser_send_page_text_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_browser_send_page_text"
                        android:src="@drawable/ic_toolbar_send"
                        android:tint="?attr/termuxActivityDrawerImageTint" />

                    <ImageButton
                        android:id="@+id/browser_send_screenshot_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_browser_send_screenshot"
                        android:src="@drawable/ic_browser_screenshot"
                        android:tint="?attr/termuxActivityDrawerImageTint" />

                    <ImageButton
                        android:id="@+id/browser_clear_cache_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_browser_clear_cache"
                        android:src="@drawable/ic_browser_clear_cache"
                        android:tint="?attr/termuxActivityDrawerImageTint" />

                    <ImageButton
                        android:id="@+id/browser_find_in_page_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/action_browser_find_in_page"
                        android:src="@drawable/ic_browser_find_in_page"
                        android:tint="?attr/termuxActivityDrawerImageTint" />

                </LinearLayout>
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <View
            android:id="@+id/session_list_bottom_sheet_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:background="@android:color/transparent"
            android:elevation="5dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/session_list_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:layout_alignParentStart="true"
            android:background="?attr/termuxActivityDrawerBackground"
            android:elevation="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/session_list_bottom_sheet_drag_handle"
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/session_list_bottom_sheet_drag_handle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/session_list_bottom_sheet_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="@string/title_session_list_bottom_sheet"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/session_list_bottom_sheet_hidden_toggle_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_session_filter_off"
                    android:padding="12dp"
                    android:src="@drawable/ic_filter_alt_off" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/session_list_bottom_sheet_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical" />

            <include
                layout="@layout/session_list_bottom_sheet_control_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/terminal_toolbar_bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/schema_terminal_chrome_surface"
            android:gravity="bottom"
            android:elevation="6dp"
            android:orientation="horizontal">

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/terminal_toolbar_view_pager"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@color/schema_terminal_chrome_surface" />

            <LinearLayout
                android:id="@+id/terminal_toolbar_right_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:id="@+id/terminal_toolbar_icon_button_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/terminal_toolbar_icon_button_row"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/terminal_toolbar_browser_toggle_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/action_toggle_browser"
                            android:layout_gravity="center_vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:src="@drawable/ic_browser_toggle"
                            android:tint="@color/white" />

                        <ImageButton
                            android:id="@+id/terminal_toolbar_keyboard_toggle_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/action_toggle_soft_keyboard_bar"
                            android:layout_gravity="center_vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:src="@drawable/ic_keyboard_toggle"
                            android:tint="@color/white" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical">

                            <ImageButton
                                android:id="@+id/terminal_toolbar_previous_session_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/action_switch_to_previous_session"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:src="@drawable/ic_toolbar_session_prev"
                                android:tint="@color/white" />

                            <TextView
                                android:id="@+id/terminal_toolbar_previous_session_count_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_session_nav_count_badge"
                                android:minWidth="16dp"
                                android:gravity="center"
                                android:paddingHorizontal="4dp"
                                android:textColor="@color/white"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical">

                            <ImageButton
                                android:id="@+id/terminal_toolbar_next_session_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/action_switch_to_next_session"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:src="@drawable/ic_toolbar_session_next"
                                android:tint="@color/white" />

                            <TextView
                                android:id="@+id/terminal_toolbar_next_session_count_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_session_nav_count_badge"
                                android:minWidth="16dp"
                                android:gravity="center"
                                android:paddingHorizontal="4dp"
                                android:textColor="@color/white"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical">

                            <ImageButton
                                android:id="@+id/terminal_toolbar_jump_to_calling_session_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?android:attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/action_jump_to_calling_session"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:src="@drawable/ic_toolbar_jump_to_calling_session"
                                android:tint="@color/white" />

                            <TextView
                                android:id="@+id/terminal_toolbar_jump_to_calling_session_count_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:background="@drawable/bg_session_nav_count_badge"
                                android:minWidth="16dp"
                                android:gravity="center"
                                android:paddingHorizontal="4dp"
                                android:textColor="@color/white"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </FrameLayout>

                        <ImageButton
                            android:id="@+id/terminal_toolbar_session_sheet_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/action_open_session_sheet"
                            android:layout_gravity="center_vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:src="@drawable/ic_session_sheet_toggle"
                            android:tint="@color/white" />

                        <ImageButton
                            android:id="@+id/terminal_toolbar_right_drawer_toggle_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/action_toggle_right_drawer_bar"
                            android:layout_gravity="center_vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:src="@drawable/ic_drawer_toggle"
                            android:tint="@color/white" />
                    </LinearLayout>
                </HorizontalScrollView>

                <include
                    android:id="@+id/terminal_toolbar_text_input_row"
                    layout="@layout/view_terminal_toolbar_text_input"
                    android:layout_width="match_parent"
                    android:layout_height="32dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/terminal_toolbar_bottom_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:layout_alignParentStart="true"
            android:background="?attr/termuxActivityBottomSeparatorColor"
            android:elevation="6dp"
            android:importantForAccessibility="no" />

        <ProgressBar
            android:id="@+id/session_definition_loading_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:layout_alignParentStart="true"
            android:clickable="false"
            android:focusable="false"
            android:indeterminate="true"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/session_switch_picker_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:clickable="false"
            android:elevation="12dp"
            android:focusable="false"
            android:visibility="gone">

            <TextView
                android:id="@+id/session_switch_picker_structure"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="@drawable/session_switch_picker_overlay_background"
                android:clickable="false"
                android:focusable="false"
                android:gravity="top|start"
                android:lineSpacingExtra="1dp"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:scrollbars="none"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp" />
        </FrameLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/apk_update_floating_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/terminal_toolbar_bottom_container"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:elevation="14dp"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:contentDescription="@string/apk_update_floating_indicator_content_description_generic"
            app:srcCompat="@drawable/ic_apk_update_available"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/owner_call_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:background="@drawable/owner_call_dialog_background"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/owner_call_dialog_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/owner_call_dialog_relative_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/owner_call_dialog_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <ImageButton
                    android:id="@+id/owner_call_dialog_previous_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/owner_call_dialog_previous_content_description"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    android:src="@drawable/ic_owner_call_previous"
                    android:tint="@color/white" />

                <ImageButton
                    android:id="@+id/owner_call_dialog_next_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/owner_call_dialog_next_content_description"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    android:src="@drawable/ic_owner_call_next"
                    android:tint="@color/white" />

                <ImageButton
                    android:id="@+id/owner_call_dialog_close_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/owner_call_dialog_close_content_description"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    android:src="@drawable/ic_browser_find_close"
                    android:tint="@color/white" />

            </LinearLayout>

            <ScrollView
                android:id="@+id/owner_call_dialog_body_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/owner_call_dialog_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="6dp"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </ScrollView>

        </LinearLayout>

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
