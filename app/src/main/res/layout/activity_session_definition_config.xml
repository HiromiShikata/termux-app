<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/session_definition_url_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_session_definition_url"
        android:inputType="textUri"
        android:gravity="top" />

    <TextView
        android:id="@+id/session_definition_reload_interval_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_session_definition_reload_interval_minutes" />

    <EditText
        android:id="@+id/session_definition_reload_interval_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hint_session_definition_reload_interval_minutes"
        android:inputType="number"
        android:gravity="top" />

    <TextView
        android:id="@+id/session_definition_max_sessions_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_session_definition_max_sessions" />

    <EditText
        android:id="@+id/session_definition_max_sessions_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/hint_session_definition_max_sessions"
        android:inputType="number"
        android:gravity="top" />

    <CheckBox
        android:id="@+id/session_definition_remove_github_sessions_not_in_list_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_session_definition_remove_github_sessions_not_in_list" />

    <TextView
        android:id="@+id/session_definition_remove_github_sessions_not_in_list_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/summary_session_definition_remove_github_sessions_not_in_list"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/session_definition_config_save_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/action_session_definition_config_save" />

</LinearLayout>
