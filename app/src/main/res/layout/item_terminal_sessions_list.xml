<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_row"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants"
    android:background="@drawable/session_ripple">

    <View
        android:id="@+id/session_row_group_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/session_row_group_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/session_active_indicator_bar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/session_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="5"
                android:gravity="start|center_vertical"
                android:lineSpacingMultiplier="0.95"
                android:padding="6dip"
                android:textSize="12sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/session_row_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="6dip"
                android:paddingBottom="4dip"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/session_reconnecting_indicator"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="14dip"
            android:layout_height="14dip"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dip"
            android:indeterminate="true"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/session_disable_toggle"
            android:layout_width="48dip"
            android:layout_height="48dip"
            android:minWidth="48dip"
            android:minHeight="48dip"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dip"
            android:layout_marginEnd="6dip"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:contentDescription="@string/action_toggle_session_navigation_disabled"
            android:duplicateParentState="false"
            android:padding="12dip"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_session_navigation_enabled" />
    </LinearLayout>
</LinearLayout>
